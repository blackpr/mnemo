# Local development database (docker compose up -d db)
DATABASE_URL=postgres://mem:mem@localhost:5433/mem
# Tests truncate every table: always a separate database
TEST_DATABASE_URL=postgres://mem:mem@localhost:5433/mem_test

# Provider credentials for extraction (only the ones your banks' extractors use)
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1   # e.g. Ollama
# OPENAI_COMPATIBLE_API_KEY=

# Retrieval embedder: "provider:model" (openai or google; Anthropic has no embeddings API) or "hashing" (offline test double).
# Changing it requires `npm run admin -- reindex --bank <id>` for existing banks.
EMBEDDER=openai:text-embedding-3-small
# Pin the dimensionality (recommended in production; changing it is an embedder switch): 1536 for text-embedding-3-small, 3072 or 768 for gemini-embedding-001
# EMBEDDING_DIMENSIONS=1536
# EMBEDDER_TIMEOUT_MS=60000

# Eval harness (eval/README.md): API key of principal `eval-runner` (tenant t-eval), issued with
# `npm run admin -- issue-key --principal eval-runner`; the arms call REST on MEM_BASE_URL with it.
# MEM_API_KEY=mem_...
# MEM_BASE_URL=http://localhost:8787
# Optional knobs: EVAL_B_EXTRACTOR=none (arm B without extraction), EVAL_RECALL_LIMIT=10,
# EVAL_MAX_CONVERSATIONS / EVAL_MAX_QUESTIONS / EVAL_MAX_PER_CONVERSATION / EVAL_CONVERSATIONS /
# EVAL_REQUIRE_AUDITED=1 (question subsets), EVAL_CORPUS_SOURCE / EVAL_CORPUS_EXCLUDE (corpus builder),
# EVAL_DRAIN_TIMEOUT_MS, EVAL_LLM_TIMEOUT_MS, PROMPTFOO_CACHE_ENABLED=false (re-spend on purpose).

# Spike engines (spike-plan-hindsight-vs-honcho.md, arms C and D), optional docker-compose profiles:
# `npm run engines:up` (both), `engines:hindsight:up`, `engines:honcho:up`, `engines:down`. Both read
# ANTHROPIC_API_KEY (extraction, Opus 5.5 by default) and OPENAI_API_KEY (embeddings, text-embedding-3-small).
# Hindsight: API on 127.0.0.1:8888, UI on 9999, its own API key (server auth is off upstream by default; on here).
# HINDSIGHT_API_KEY=<any long random string, e.g. openssl rand -hex 24>
# HINDSIGHT_BASE_URL=http://127.0.0.1:8888
# HINDSIGHT_LLM_PROVIDER=anthropic   HINDSIGHT_LLM_MODEL=claude-opus-5-5   HINDSIGHT_LLM_API_KEY=<defaults to ANTHROPIC_API_KEY>
# Honcho: API on 127.0.0.1:8010, deriver metrics on 9091, JWT auth on; mint the admin token with
# `npm run engines:honcho:admin-jwt` after the first `engines:honcho:up` and put it in HONCHO_API_KEY.
# HONCHO_JWT_SECRET=<any long random string, e.g. openssl rand -hex 32>
# HONCHO_API_KEY=<output of npm run engines:honcho:admin-jwt>
# HONCHO_BASE_URL=http://127.0.0.1:8010
# HONCHO_LLM_TRANSPORT=anthropic   HONCHO_LLM_MODEL=claude-sonnet-4-5   (Honcho 3.4.1 cannot drive Claude 5 models; see docker-compose.yml)
# ENGINE selects the RetrievalEngine behind the server and admin CLI: pgvector (default), hindsight, honcho.
# The engine adapters' contract tests need the containers: `npm run test:engines` (RUN_ENGINE_TESTS=1).
# ENGINE=pgvector
