{
  "name": "mem",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Self-hosted, provider-agnostic memory layer: a system of record for what AI assistants know about you.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs",
    "db:up": "docker compose up -d db && docker compose exec -T db sh -c 'until pg_isready -U mem -d mem -q; do sleep 1; done; createdb -U mem mem_test 2>/dev/null || true'",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/platform/postgres/migrate-cli.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/attachment/rest/main.ts",
    "admin": "node --env-file-if-exists=.env --import tsx src/cli/admin.ts",
    "test:live": "RUN_LIVE_TESTS=1 node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/openai": "^4.0.101",
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ai": "^7.0.150",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
