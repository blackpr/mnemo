{
  "name": "mem",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Self-hosted, provider-agnostic memory layer: a system of record for what AI assistants know about you.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/platform/postgres/migrate-cli.ts",
    "start": "tsx src/attachment/rest/main.ts",
    "admin": "tsx src/cli/admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
