{
  "name": "mem",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Self-hosted, provider-agnostic memory layer: a system of record for what AI assistants know about you.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/platform/postgres/migrate-cli.ts"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
